# BMAD Install Configuration
# Used by scripts/install-bmad.sh to run the installer non-interactively.
# All values below map directly to npx bmad-method install flags.
#
# Run: bash scripts/install-bmad.sh
#   or: pnpm run bmad:install

# ── Modules to install ────────────────────────────────────────────────────────
# "core" is always added automatically — do not list it here.
# Available: bmm, bmb, tea, cis, gds
MODULES=bmm,bmb,tea,cis

# ── IDEs / tools to configure ─────────────────────────────────────────────────
# Run: npx bmad-method install --list-tools   to see all valid IDs
TOOLS=claude-code,github-copilot

# ── Core settings ─────────────────────────────────────────────────────────────
# Leave empty to auto-detect from git config / system locale / directory name.
USER_NAME="BMAD_MANAGER_USERNAME"
PROJECT_NAME="BMAD_MANAGER_PROJECT_NAME"
COMMUNICATION_LANGUAGE="BMAD_MANAGER_COMMUNICATION_LANGUAGE"       # e.g. English, French, Spanish
DOCUMENT_OUTPUT_LANGUAGE="BMAD_MANAGER_OUTPUT_LANGUAGE"     # e.g. English, French — defaults to English

# ── Module configuration ──────────────────────────────────────────────────────
# Each entry maps to a --set flag: "module.key=value"
# Run: npx bmad-method install --list-options [module]   to see all available keys
# or: bash scripts/install-bmad.sh --list-options [module]
MODULE_CONFIG=(
    # ── bmm ───────────────────────────────────────────────────────────────────
    "bmm.user_skill_level=expert"           # beginner | intermediate | expert
    "bmm.planning_artifacts={project-root}/_bmad-output/planning-artifacts"
    "bmm.implementation_artifacts={project-root}/_bmad-output/implementation-artifacts"
    "bmm.project_knowledge={project-root}/_bmad-docs"

    # ── tea ───────────────────────────────────────────────────────────────────
    "tea.test_artifacts={project-root}/_bmad-output/test-artifacts"
    "tea.tea_use_playwright_utils=true"
    "tea.tea_use_pactjs_utils=false"
    "tea.tea_capability_probe=true"
    "tea.tea_pact_mcp=none"               # none | pact-broker | pactflow
    "tea.tea_browser_automation=auto"     # auto | playwright | cypress | none
    "tea.tea_execution_mode=auto"         # auto | local | ci
    "tea.test_stack_type=auto"            # auto | unit | integration | e2e | all
    "tea.ci_platform=auto"               # auto | github-actions | gitlab-ci | none
    "tea.test_framework=auto"            # auto | jest | vitest | pytest | go-test | ...
    "tea.risk_threshold=p3"              # p1 | p2 | p3 | p4
    "tea.test_design_output=_bmad-output/test-artifacts/test-design"
    "tea.test_review_output=_bmad-output/test-artifacts/test-reviews"
    "tea.trace_output=_bmad-output/test-artifacts/traceability"

    # ── bmb ───────────────────────────────────────────────────────────────────
    "bmb.bmad_builder_output_folder={project-root}/_bmad-custom/skills"
    "bmb.bmad_builder_reports={project-root}/_bmad-custom/skills-reports"

    # ── cis ───────────────────────────────────────────────────────────────────
    "cis.visual_tools=mermaid,excalidraw,gemini-nano"
)

# ── Channel configuration ──────────────────────────────────────────────────────
# Channels control which version is installed for external modules:
#
# | Channel | What it installs                          | Use case                        |
# |---------|-------------------------------------------|---------------------------------|
# | stable  | Latest semver tag (default)               | Most users                      |
# | next    | HEAD of main branch at install time       | Contributors, early adopters    |
# | pinned  | Specific version tag (via --pin)          | Enterprise, reproducible CI     |
#
# Set --channel applies to all external modules (bmb, cis, gds, tea).
# Use --pin or --next for per-module control.
CHANNEL=stable                # stable (default) | next

# ── Version pins (leave commented for latest stable) ─────────────────────────
# Uncomment to pin a specific release. Use values from manifest.yaml.
# PIN_BMB=v2.0.0
# PIN_CIS=v0.2.1
# PIN_TEA=v1.19.0
# PIN_GDS=<version>
